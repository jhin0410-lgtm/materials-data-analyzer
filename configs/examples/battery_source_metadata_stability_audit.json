      "description": "Median of earliest five positive analysis-ready capacities",
      "overrides": {
        "reference_capacity_policy": "first_n_median_first_5",
        "reference_window": 5
      }
    },
    {
      "policy_id": "window_three_predeclared",
      "policy_axis": "window",
      "description": "Three-observation descriptive window",
      "overrides": {
        "window_size": 3,
        "minimum_window_support": 3
      }
    },
    {
      "policy_id": "window_seven_predeclared",
      "policy_axis": "window",
      "description": "Seven-observation descriptive window",
      "overrides": {
        "window_size": 7,
        "minimum_window_support": 7
      }
    },
    {
      "policy_id": "gap_allow_two_predeclared",
      "policy_axis": "gap",
      "description": "Allow adjacent cycle-index gaps up to two",
      "overrides": {
        "gap_exclusion_threshold": 2
      }
    },
    {
      "policy_id": "gap_allow_three_predeclared",
      "policy_axis": "gap",
      "description": "Allow adjacent cycle-index gaps up to three",
      "overrides": {
        "gap_exclusion_threshold": 3
      }
