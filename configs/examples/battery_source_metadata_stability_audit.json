      "description": "Exact v2.3.4 evaluator policy",
      "overrides": {}
    },
    {
      "policy_id": "threshold_relaxed_predeclared",
      "policy_axis": "threshold",
      "description": "Predeclared lower event and variability thresholds",
      "overrides": {
        "absolute_detection_floor": 0.0025,
        "robust_scale_multiplier": 4.0,
        "plateau_threshold": 0.015,
        "accelerated_fade_threshold": 0.00125,
        "high_variability_scale_threshold": 0.0075
      }
    },
    {
      "policy_id": "threshold_strict_predeclared",
      "policy_axis": "threshold",
      "description": "Predeclared higher event and variability thresholds",
      "overrides": {
        "absolute_detection_floor": 0.01,
        "robust_scale_multiplier": 8.0,
        "plateau_threshold": 0.005,
        "accelerated_fade_threshold": 0.005,
        "high_variability_scale_threshold": 0.02
      }
    },
    {
      "policy_id": "reference_first_valid_predeclared",
      "policy_axis": "reference",
      "description": "Earliest positive analysis-ready discharge capacity",
      "overrides": {
        "reference_capacity_policy": "first_valid_discharge_capacity",
        "reference_window": 1
      }
    },
    {
      "policy_id": "reference_first_five_analysis_ready_predeclared",
