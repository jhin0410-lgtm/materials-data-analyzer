      "required_inputs": [
        {
          "description": "Active immutable research state containing checksum-bound prerequisite action reports.",
          "kind": "research_state",
          "name": "research_state",
          "required": true
        },
        {
          "description": "Verified protocol-stratification or target-reference report establishing the unresolved blocker.",
