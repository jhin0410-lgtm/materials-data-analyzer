{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "scalar_field_1d_result_schema_v1",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1"},
    "result_id": {"type": "string"},
    "result_type": {"const": "scalar_field_1d"},
    "operator_id": {"enum": ["one_dimensional_diffusion_exact_propagator_v1", "one_dimensional_diffusion_ftcs_propagator_v1"]},
    "operator_role": {"const": "Propagator"},
    "execution_status": {"enum": ["benchmark_executed", "blocked_nonfinite_result"]},
    "field_id": {"const": "scalar_field_c"},
    "field_unit": {"type": "string"},
    "x_unit": {"const": "m"},
    "time_unit": {"const": "s"},
    "x": {"type": "array", "items": {"type": "number"}},
    "time": {"type": "array", "items": {"type": "number"}},
    "values": {"type": "array", "items": {"type": "array", "items": {"type": "number"}}},
    "shape": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer"}},
    "stability_ratio": {"type": "number"},
    "stability_requirement": {"type": "string"},
    "requested_dx": {"type": "number"},
    "requested_dt": {"type": "number"},
    "effective_dx": {"type": "number"},
    "effective_dt": {"type": "number"},
    "silent_adjustment_performed": {"const": false},
    "deterministic": {"const": true},
    "solver_executed": {"type": "boolean"},
    "network_called": {"const": false},
    "model_fitting_performed": {"const": false},
    "uncertainty": {"type": "object"},
    "checksum_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "required": ["schema_version", "result_id", "result_type", "operator_id", "operator_role", "execution_status", "field_id", "field_unit", "x_unit", "time_unit", "x", "time", "values", "shape", "deterministic", "network_called", "model_fitting_performed", "uncertainty", "checksum_sha256"],
  "title": "Local-only one-dimensional scalar field result",
  "type": "object"
}
