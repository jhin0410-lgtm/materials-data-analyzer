{
  "schema_id": "external_dataset_schema_v1",
  "schema_version": "1",
  "status": "active",
  "required_fields": [
    "dataset_id",
    "source_system_id",
    "title",
    "description",
    "domain_contexts",
    "authoritative_identifier",
    "identifiers",
    "publisher",
    "citation",
    "license_or_access_conditions",
    "expected_resource_types",
    "uncertainty_availability",
    "calibration_metadata_availability",
    "status"
  ],
  "identity_policy": "logical_dataset_identity_is_distinct_from_source_system_and_snapshot",
  "compatibility_policy": {
    "unknown_fields": "reject",
    "unsupported_future_version": "reject",
    "silent_field_drop": false
  }
}
