{
  "schema_version": "2.2.3",
  "schema_id": "scientific_operator_registry_schema_v2",
  "status": "release_ready",
  "required_fields": [
    "operator_id",
    "operator_version",
    "input_entity_types",
    "output_types",
    "required_fields",
    "side_effect_policy",
    "network_policy",
    "uncertainty_policy",
