    "domain",
    "name",
    "description",
    "constraint_ids",
    "status",
    "version"
  ],
  "pack_components": [
    "variables",
    "assumptions",
    "mechanisms",
    "feature_definitions",
    "cautions"
  ],
  "security_policy": {
    "pack_can_define_code": false,
    "pack_can_define_callables": false,
    "pack_can_read_data": false,
    "pack_can_train_models": false
  }
}
