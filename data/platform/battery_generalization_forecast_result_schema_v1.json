{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battery_generalization_forecast_result_schema_v1",
  "title": "Battery Generalization Forecast Result",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_kind",
    "benchmark_id",
    "evaluation_scenario",
    "source_sha256",
    "forecast_horizon_cycles",
    "aggregate_metrics",
    "baseline_comparison",
    "leakage_checks",
    "physical_plausibility_checks",
    "software_validation",
    "scientific_assessment",
    "deterministic_result_checksum"
  ],
  "properties": {
    "schema_version": {
      "const": "2.6.1"
    },
    "artifact_kind": {
      "enum": [
        "battery_generalization_forecast_result",
        "battery_generalization_forecast_compact_summary"
      ]
    },
    "benchmark_id": {
      "const": "battery_warm_start_cross_battery_forecast_v1"
    },
    "evaluation_scenario": {
      "const": "warm_start_cross_battery"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "forecast_horizon_cycles": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_metrics": {
      "type": "array"
    },
    "baseline_comparison": {
      "type": "object"
    },
    "leakage_checks": {
      "type": "object"
    },
    "physical_plausibility_checks": {
      "type": "array"
    },
    "software_validation": {
      "type": "string"
    },
    "scientific_assessment": {
      "type": "object"
    },
    "deterministic_result_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
