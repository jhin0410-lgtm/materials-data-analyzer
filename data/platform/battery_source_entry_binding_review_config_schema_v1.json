{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battery_source_entry_binding_review_config_schema_v1.json",
  "schema_version": "1",
  "status": "active",
  "title": "Battery SNL LFP Source-to-Entry Binding Review Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "case_study_id",
    "bounded_source_id",
    "source_entry_binding_manifest_path",
    "v2_6_5_source_evidence_summary_path",
    "v2_6_6_artifact_binding_summary_path",
    "expected_v2_6_5_checksum",
    "expected_v2_6_6_checksum",
    "required_evidence_fields",
    "required_binding_dimensions",
    "read_policy",
    "credential_policy",
    "output_root",
    "tracked_summary_path",
    "output_policy",
    "dry_run"
  ],
  "properties": {
    "schema_version": {"const": "2.6.7"},
    "package_id": {"const": "battery_snl_lfp_source_entry_binding_review_v1"},
    "case_study_id": {"const": "battery_archive_snl_lfp"},
    "bounded_source_id": {"const": "snl_lfp_commercial_18650_study"},
    "source_entry_binding_manifest_path": {"const": "data/platform/battery_snl_lfp_source_entry_binding_manifest_v1.json"},
    "v2_6_5_source_evidence_summary_path": {"const": "data/processed/battery_v2_6_5_snl_lfp_source_evidence_summary.json"},
    "v2_6_6_artifact_binding_summary_path": {"const": "data/processed/battery_v2_6_6_snl_lfp_artifact_binding_summary.json"},
    "expected_v2_6_5_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_v2_6_6_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "required_evidence_fields": {"const": ["chemistry", "nominal_capacity", "ambient_temperature", "charge_protocol", "discharge_protocol", "cutoff_voltage", "measurement_calibration", "source_snapshot"]},
    "required_binding_dimensions": {"const": ["publication_to_repository", "repository_filename_nomenclature", "study_to_condition_group", "condition_group_to_entry_pattern", "physical_cell_to_entry", "cycle_command_to_rows", "instrument_channel_to_columns", "official_distribution_snapshot"]},
    "read_policy": {"const": {"allow_tracked_json_reads": true, "allow_raw_archive_read": false, "allow_entry_payload_read": false, "allow_csv_header_read": false, "allow_csv_row_read": false, "allow_archive_extraction": false}},
    "credential_policy": {"const": {"store_credentials": false, "network_access_required": false}},
    "output_root": {"const": "outputs/v2_6_battery_snl_lfp_source_entry_binding"},
    "tracked_summary_path": {"const": "data/processed/battery_v2_6_7_snl_lfp_source_entry_binding_summary.json"},
    "output_policy": {"const": "tracked_compact_summary_and_local_full_result"},
    "dry_run": {"const": true}
  }
}
