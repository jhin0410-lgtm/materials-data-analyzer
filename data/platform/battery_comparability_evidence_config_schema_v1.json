{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battery_comparability_evidence_config_schema_v1.json",
  "title": "Battery Comparability Evidence Config",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_id",
    "case_study_id",
    "source_analysis_ready_path",
    "source_lineage_path",
    "metadata_recovery_summary_path",
    "source_benchmark_summary_path",
    "source_diagnostic_summary_path",
    "expected_benchmark_checksum",
    "expected_diagnostic_checksum",
    "group_column",
    "temperature_column",
    "required_evidence_fields",
    "credential_policy",
    "output_root",
    "tracked_summary_path",
    "output_policy"
  ],
  "properties": {
    "schema_version": {"const": "2.6.3"},
    "package_id": {"const": "battery_comparability_evidence_package_v1"},
    "case_study_id": {"const": "kaggle_battery"},
    "source_analysis_ready_path": {"type": "string"},
    "source_lineage_path": {"type": "string"},
    "metadata_recovery_summary_path": {"type": "string"},
    "source_benchmark_summary_path": {"type": "string"},
    "source_diagnostic_summary_path": {"type": "string"},
    "expected_benchmark_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_diagnostic_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "group_column": {"const": "battery_id"},
    "temperature_column": {"const": "ambient_temperature_c"},
    "required_evidence_fields": {
      "const": [
        "chemistry",
        "nominal_capacity",
        "ambient_temperature",
        "charge_protocol",
        "discharge_protocol",
        "cutoff_voltage",
        "measurement_calibration",
        "source_snapshot"
      ]
    },
    "credential_policy": {
      "const": {"store_credentials": false, "network_access_required": false}
    },
    "output_root": {"const": "outputs/v2_6_battery_comparability"},
    "tracked_summary_path": {
      "const": "data/processed/battery_v2_6_3_comparability_evidence_summary.json"
    },
    "output_policy": {"const": "local_details_and_tracked_compact_summary"}
  }
}
