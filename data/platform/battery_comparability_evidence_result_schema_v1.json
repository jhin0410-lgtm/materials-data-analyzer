{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battery_comparability_evidence_result_schema_v1.json",
  "title": "Battery Comparability Evidence Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "package_id",
    "case_study_id",
    "source_references",
    "source_artifact_checksums",
    "required_evidence_fields",
    "evidence_matrix",
    "coverage_summary",
    "preservation_checks",
    "comparability_decision",
    "scientific_closeout",
    "unresolved_information",
    "recommendations",
    "prohibited_claims",
    "network_called",
    "credentials_read",
    "source_mutation_performed",
    "model_retrained",
    "metrics_recomputed",
    "data_inference_performed",
    "same_condition_assumption_made",
    "first_run_checksum",
    "second_run_checksum",
    "deterministic_rerun_match",
    "deterministic_result_checksum"
  ],
  "properties": {
    "schema_version": {"const": "2.6.3"},
    "artifact_kind": {
      "enum": [
        "battery_comparability_evidence_result",
        "battery_comparability_evidence_compact_summary"
      ]
    },
    "package_id": {"const": "battery_comparability_evidence_package_v1"},
    "case_study_id": {"const": "kaggle_battery"},
    "source_references": {"type": "object"},
    "source_artifact_checksums": {"type": "object"},
    "required_evidence_fields": {
      "const": [
        "chemistry",
        "nominal_capacity",
        "ambient_temperature",
        "charge_protocol",
        "discharge_protocol",
        "cutoff_voltage",
        "measurement_calibration",
        "source_snapshot"
      ]
    },
    "evidence_matrix": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_field",
          "evidence_status",
          "evidence_scope",
          "expected_battery_count",
          "supported_battery_count",
          "supported_record_count",
          "observed_value_count",
          "source_reference",
          "evidence_statement",
          "limitation",
          "external_data_required",
          "comparability_established",
          "inference_performed",
          "same_condition_assumption_made"
        ],
        "properties": {
          "evidence_field": {
            "enum": [
              "chemistry",
              "nominal_capacity",
              "ambient_temperature",
              "charge_protocol",
              "discharge_protocol",
              "cutoff_voltage",
              "measurement_calibration",
              "source_snapshot"
            ]
          },
          "evidence_status": {"type": "string"},
          "evidence_scope": {"type": "string"},
          "expected_battery_count": {"type": "integer", "minimum": 0},
          "supported_battery_count": {"type": "integer", "minimum": 0},
          "supported_record_count": {"type": "integer", "minimum": 0},
          "observed_value_count": {"type": ["integer", "null"], "minimum": 0},
          "source_reference": {"type": "string"},
          "evidence_statement": {"type": "string"},
          "limitation": {"type": "string"},
          "external_data_required": {"type": "boolean"},
          "comparability_established": {"const": false},
          "inference_performed": {"const": false},
          "same_condition_assumption_made": {"const": false}
        }
      }
    },
    "coverage_summary": {"type": "object"},
    "preservation_checks": {"type": "object"},
    "comparability_decision": {"type": "object"},
    "scientific_closeout": {"type": "object"},
    "unresolved_information": {"type": "array", "items": {"type": "string"}},
    "recommendations": {"type": "array", "items": {"type": "string"}},
    "prohibited_claims": {"type": "array", "items": {"type": "string"}},
    "network_called": {"const": false},
    "credentials_read": {"const": false},
    "source_mutation_performed": {"const": false},
    "model_retrained": {"const": false},
    "metrics_recomputed": {"const": false},
    "data_inference_performed": {"const": false},
    "same_condition_assumption_made": {"const": false},
    "source_hashes_before": {"type": "object"},
    "source_hashes_after": {"type": "object"},
    "first_run_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "second_run_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "deterministic_rerun_match": {"const": true},
    "deterministic_result_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_kind": {"const": "battery_comparability_evidence_result"}
        }
      },
      "then": {
        "required": ["source_hashes_before", "source_hashes_after"]
      }
    }
  ]
}
