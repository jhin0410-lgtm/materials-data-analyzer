{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battery_forecast_diagnostic_result_schema_v1.json",
  "title": "Battery Forecast Failure Diagnostic Result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "diagnostic_id",
    "source_benchmark_reference",
    "source_benchmark_checksum",
    "source_benchmark_result_checksum",
    "source_predictions_sha256",
    "source_analysis_ready_reference",
    "source_analysis_ready_sha256",
    "evaluation_scenario",
    "forecast_horizon_cycles",
    "battery_count",
    "prediction_count",
    "aggregate_metrics",
    "influence_summary",
    "degradation_regime_metrics",
    "physical_violation_analysis",
    "comparability_readiness",
    "dominant_failure_modes",
    "scientific_closeout",
    "network_called",
    "credentials_read",
    "source_mutation_performed",
    "model_retrained",
    "source_benchmark_model_reexecuted",
    "first_run_checksum",
    "second_run_checksum",
    "deterministic_rerun_match",
    "deterministic_result_checksum"
  ],
  "properties": {
    "schema_version": {
      "const": "2.6.2"
    },
    "artifact_kind": {
      "enum": [
        "battery_forecast_failure_diagnostic_result",
        "battery_forecast_failure_diagnostic_compact_summary"
      ]
    },
    "diagnostic_id": {
      "const": "battery_forecast_failure_diagnostics_v1"
    },
    "case_study_id": {
      "const": "kaggle_battery"
    },
    "source_benchmark_reference": {
      "type": "string"
    },
    "source_benchmark_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_benchmark_result_reference": {
      "type": "string"
    },
    "source_benchmark_result_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_predictions_reference": {
      "type": "string"
    },
    "source_predictions_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_analysis_ready_reference": {
      "type": "string"
    },
    "source_analysis_ready_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_lineage_reference": {
      "type": "string"
    },
    "evaluation_scenario": {
      "const": "warm_start_cross_battery"
    },
    "forecast_horizon_cycles": {
      "const": 5
    },
    "battery_count": {
      "type": "integer",
      "minimum": 1
    },
    "prediction_count": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_metrics": {
      "type": "array"
    },
    "influence_summary": {
      "type": "object"
    },
    "per_battery_diagnostics": {
      "type": "array"
    },
    "influence_analysis": {
      "type": "array"
    },
    "trajectory_quality_flags": {
      "type": "array"
    },
    "degradation_regime_metrics": {
      "type": "array"
    },
    "local_trend_relationships": {
      "type": "array"
    },
    "physical_violation_analysis": {
      "type": "object"
    },
    "comparability_readiness": {
      "type": "object"
    },
    "dominant_failure_modes": {
      "type": "array"
    },
    "unresolved_information": {
      "type": "array"
    },
    "recommendations": {
      "type": "array"
    },
    "prohibited_claims": {
      "type": "array"
    },
    "scientific_closeout": {
      "type": "object"
    },
    "diagnostic_thresholds": {
      "type": "object"
    },
    "regime_policy": {
      "type": "object"
    },
    "network_called": {
      "const": false
    },
    "credentials_read": {
      "const": false
    },
    "source_mutation_performed": {
      "const": false
    },
    "model_retrained": {
      "const": false
    },
    "source_benchmark_model_reexecuted": {
      "type": "boolean"
    },
    "source_benchmark_regenerated": {
      "type": "boolean"
    },
    "source_benchmark_checksum_verified": {
      "const": true
    },
    "diagnostic_model_trained": {
      "const": false
    },
    "model_tuned": {
      "const": false
    },
    "first_run_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "second_run_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "deterministic_rerun_match": {
      "const": true
    },
    "source_hashes_before": {
      "type": "object"
    },
    "source_hashes_after": {
      "type": "object"
    },
    "deterministic_result_checksum": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "artifact_kind": {
            "const": "battery_forecast_failure_diagnostic_compact_summary"
          }
        }
      },
      "then": {
        "required": [
          "source_benchmark_regenerated",
          "source_benchmark_checksum_verified",
          "diagnostic_model_trained",
          "model_tuned"
        ]
      }
    }
  ]
}
