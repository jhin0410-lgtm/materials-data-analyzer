{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "battery_artifact_binding_audit_result_schema_v1.json",
  "schema_version": "1",
  "status": "active",
  "title": "Battery SNL LFP Artifact Binding Audit Result",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "artifact_kind",
    "package_id",
    "case_study_id",
    "bounded_source_id",
    "archive_path",
    "archive_audit",
    "binding_decision",
    "evidence_promotion",
    "preservation_checks",
    "scientific_closeout",
    "archive_bytes_read_for_checksum",
    "zip_central_directory_read",
    "archives_extracted",
    "entry_payloads_read",
    "csv_rows_read",
    "model_trained",
    "model_evaluated",
    "metrics_recomputed",
    "deterministic_result_checksum"
  ],
  "properties": {
    "schema_version": {"const": "2.6.6"},
    "artifact_kind": {
      "enum": [
        "battery_snl_lfp_artifact_binding_result",
        "battery_snl_lfp_artifact_binding_compact_summary"
      ]
    },
    "package_id": {"const": "battery_snl_lfp_artifact_binding_audit_v1"},
    "case_study_id": {"const": "battery_archive_snl_lfp"},
    "bounded_source_id": {"const": "snl_lfp_commercial_18650_study"},
    "archive_path": {"const": "data/raw/battery_archive/SNL LFP.zip"},
    "archive_audit": {"type": "object"},
    "binding_decision": {"type": "object"},
    "evidence_promotion": {"type": "object"},
    "preservation_checks": {"type": "object"},
    "scientific_closeout": {"type": "object"},
    "archive_bytes_read_for_checksum": {"type": "boolean"},
    "zip_central_directory_read": {"type": "boolean"},
    "archives_extracted": {"const": false},
    "entry_payloads_read": {"const": false},
    "csv_rows_read": {"const": false},
    "network_called": {"const": false},
    "credentials_read": {"const": false},
    "source_mutation_performed": {"const": false},
    "model_trained": {"const": false},
    "model_evaluated": {"const": false},
    "metrics_recomputed": {"const": false},
    "data_inference_performed": {"const": false},
    "document_to_archive_binding_inferred": {"const": false},
    "filename_labels_promoted_to_scientific_evidence": {"const": false},
    "deterministic_result_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
