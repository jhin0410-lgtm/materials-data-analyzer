# --- 파이썬 및 환경 관련 ---
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/
.env
*.env

# --- Raw 및 Local 데이터셋 ---
# Ignore all raw/local downloaded data.
data/raw/**

# Keep only the top-level raw data policy document.
!data/raw/
!data/raw/README.md

# --- 설정 및 자격 증명 (민감 정보) ---
configs/*.local.yaml
.kaggle/
kaggle.json
**/kaggle.json
api_credentials.*
*credentials*.json
*credentials*.yaml
*credentials*.yml

# --- 기타 ---
outputs/.pytest_tmp/

# --- Generated/local-only analyzer artifacts ---
# Keep compact case-study summaries trackable; ignore only large row-level
# local artifacts that are regenerated from documented scripts.
outputs/**
.pytest_tmp/
data/processed/materials_project_v1_3_raw.jsonl
data/processed/materials_project_v1_3_acquired.csv
data/processed/materials_project_v1_3_analysis_ready.csv
data/processed/materials_project_v1_3_validation_predictions.csv
data/processed/materials_project_v1_3_trust_diagnostics.csv
data/processed/smart_factory_v1_4_secom_analysis_ready.csv
data/processed/smart_factory_v1_4_classification_predictions.csv
data/processed/reliability_v1_5_backblaze_analysis_ready.csv
outputs/reliability_v1_5_local/
